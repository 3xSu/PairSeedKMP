-- 确认记录：用户在历史页答过的每一次
-- 只插不删（没有 is_deleted / updated_at）；改答 = 再插一条，按 answered_at 最新生效
CREATE TABLE user_confirmations (
    id INTEGER PRIMARY KEY,
    event_id INTEGER NOT NULL,                -- 对应事件
    answered_period TEXT NOT NULL,            -- 这次回答针对的时段：MORNING / AFTERNOON / EVENING / NIGHT
    answer TEXT NOT NULL,                     -- YES / NO
    answered_at INTEGER NOT NULL              -- 答的时刻（Unix 毫秒）；兼作 created_at
);

-- ===== 命名查询（步骤 2：数据访问）=====

insertUserConfirmation:
INSERT INTO user_confirmations (event_id, answered_period, answer, answered_at)
VALUES (?, ?, ?, ?);

lastInsertedUserConfirmationId:
SELECT last_insert_rowid();

-- 该事件最新一条：按 answered_at 最大；同刻按 id 最大（改答 = 再插一条）
selectLatestUserConfirmation:
SELECT * FROM user_confirmations WHERE event_id = ? ORDER BY answered_at DESC, id DESC LIMIT 1;
