-- 角色基础表：名字、摘要、身份定位；identity_type / default_idle_state 旧列不建
CREATE TABLE characters (
    id INTEGER PRIMARY KEY,
    pack_id INTEGER NOT NULL,                 -- 属于哪个角色组
    character_code TEXT NOT NULL,             -- 编码
    character_name TEXT NOT NULL,             -- 名字
    summary TEXT NOT NULL,                    -- 一句话摘要 → 用户填的"简介"
    is_deleted INTEGER NOT NULL DEFAULT 0,    -- 0 / 1（旧 status 并入）
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    UNIQUE (pack_id, character_code)          -- 组内编码唯一（防重）
);
