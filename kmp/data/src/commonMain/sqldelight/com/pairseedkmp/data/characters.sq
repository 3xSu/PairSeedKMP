-- 角色基础表：名字、摘要、身份定位；identity_type / default_idle_state 旧列不建
CREATE TABLE characters (
    id INTEGER PRIMARY KEY,
    pack_id INTEGER NOT NULL,                 -- 属于哪个角色组
    character_code TEXT NOT NULL,             -- 编码
    character_name TEXT NOT NULL,             -- 名字
    summary TEXT NOT NULL,                    -- 一句话摘要 → 用户填的"简介"
    is_deleted INTEGER NOT NULL DEFAULT 0,    -- 0 / 1（旧 status 并入）
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    UNIQUE (pack_id, character_code)          -- 组内编码唯一（防重）
);

-- ===== 命名查询（步骤 6：调试种子与壳）=====

insertCharacter:
INSERT INTO characters (pack_id, character_code, character_name, summary, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?);

lastInsertedCharacterId:
SELECT last_insert_rowid();

-- 组内全部角色，按 id 排（壳层解析 actor / target：第一个 = actor、第二个 = target）
selectCharactersByPack:
SELECT * FROM characters WHERE pack_id = ? AND is_deleted = 0 ORDER BY id;
